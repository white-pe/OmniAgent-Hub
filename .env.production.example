# Copy to .env.production on the server. Never commit the real file.
PAWTEAM_DOMAIN=agent.example.com

# Use a long, unique password (at least 12 characters).
PAWTEAM_ADMIN_PASSWORD=replace-with-a-long-password

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
PAWTEAM_AUTH_SECRET_KEY=replace-with-at-least-32-random-characters

# Generate once: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this key makes stored Provider/Channel secrets unreadable.
PAWTEAM_SECRET_KEY=replace-with-a-fernet-key

# Generate another independent random key for the private Qdrant service.
PAWTEAM_QDRANT_API_KEY=replace-with-an-independent-random-key
