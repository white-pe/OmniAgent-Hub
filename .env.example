PAWTEAM_ENVIRONMENT=development
PAWTEAM_HOST=127.0.0.1
PAWTEAM_PORT=8000
# Used only by the Vite development proxy.
PAWTEAM_API_PROXY_TARGET=http://127.0.0.1:8000
PAWTEAM_ALLOWED_HOSTS=["localhost","127.0.0.1"]
PAWTEAM_DATABASE_URL=sqlite+aiosqlite:///./data/app.db
PAWTEAM_DATA_DIR=./data
PAWTEAM_SECRETS_DIR=./data/secrets
PAWTEAM_WORKSPACES_DIR=./data/workspaces
PAWTEAM_PROVIDER_TIMEOUT_SECONDS=60
PAWTEAM_BLUEPRINT_TTL_MINUTES=1440
PAWTEAM_RUN_TIMEOUT_SECONDS=120
PAWTEAM_RUN_EVENT_POLL_INTERVAL_SECONDS=0.15
PAWTEAM_RUNTIME_HISTORY_MESSAGES=30
PAWTEAM_RUNTIME_HISTORY_CHARS=40000
PAWTEAM_RUNTIME_WORKSPACE_FILE_CHARS=15000
PAWTEAM_RUNTIME_SKILL_CHARS=10000
PAWTEAM_RUNTIME_MAX_STEPS=8
PAWTEAM_TOOL_TIMEOUT_SECONDS=10
PAWTEAM_TOOL_RESULT_MAX_CHARS=20000
PAWTEAM_TOOL_EVENT_PREVIEW_CHARS=1000
PAWTEAM_DELEGATION_MAX_DEPTH=2
PAWTEAM_DELEGATION_MAX_CALLS_PER_ROOT=6
PAWTEAM_DELEGATION_TASK_MAX_CHARS=8000
PAWTEAM_CHANNEL_SIGNATURE_TOLERANCE_SECONDS=300
PAWTEAM_CHANNEL_OUTBOX_LEASE_SECONDS=30
PAWTEAM_CHANNEL_OUTBOX_MAX_ATTEMPTS=5
PAWTEAM_CHANNEL_OUTBOX_BATCH_SIZE=20
PAWTEAM_CHANNEL_DELIVERY_TIMEOUT_SECONDS=10
PAWTEAM_AUTH_SESSION_HOURS=12
PAWTEAM_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Production only: inject a valid Fernet key from a secret manager. When omitted,
# local development creates data/secrets/.master.key with owner-only permissions.
# PAWTEAM_SECRET_KEY=

# Optional in local development. Setting both values enables console login.
# Production requires these values and validates their minimum strength.
# PAWTEAM_ADMIN_PASSWORD=
# PAWTEAM_AUTH_SECRET_KEY=
